local Mock=require("./V82Mock")
local passed,failed=0,0
local function test(name,fn)
 local ok,err=pcall(fn);if not ok then failed+=1;print("FAIL "..name..": "..tostring(err));return end;passed+=1;print("PASS "..name)
end
local function setup(deferred,n,options)
 local w=Mock.new(deferred);options=options or {}
 if options.color then w.color=options.color(w);w.nativePaletteColor=w.color;w.player:SetAttribute("PaintBucketColor",w.color) end
 local a=w.load(SOURCE);w.protected={};local parts={}
 if options.palette then w.makePalette(options.palette);w.learn(a) end
 for i=1,n or 1 do
  local p=w.province(-260+(i-1)%16*35,-160+math.floor((i-1)/16)*35);p.Name="Province";parts[i]=p;w.protected[p]=true;assert(a.AddProvince(p))
 end
 if options.palette then a.RerollCivilColors(101) end
 w.mouse.Target=nil;return w,a,parts
end
