 test(pre.."replacement opener and closer rebind with their exact identities",function()
  local w,a=setup(deferred,2,{palette=4});local opener,closer,show=w.makeChrome()
  show(false);assert(a.BeginPaletteLearning("OPENER"));w.humanSelect(opener);a.FinishPaletteLearning()
  assert(a.BeginPaletteLearning("CLOSER"));w.humanSelect(closer);a.FinishPaletteLearning()
  opener,closer,show=w.recreatePalette(4,true);show(false);w.flush()
  w.mapOverlay=w.instance("Frame");w.mapOverlay.Visible=false;w.mapOverlay.Active=true;w.mapOverlay.Parent=w.paletteRoot
  a.SetMode("CIVIL WAR");w.start(a,3)
  local m=a.GetPerformanceStats();assert(m.OpenerRebinds>=1 and m.CloserRebinds>=1,a.GetPerformanceReport())
  assert(a.GetStats().Dirty==0 and m.PaletteSelectionFailures==0 and m.OpenerUses>0 and m.CloserUses>0,a.GetStats().LastMessage.." "..a.GetPaletteTransactionReport())
  a.Stop();w.assertClean()
 end)
 test(pre.."semantic profile import binds current replacement buttons and paints without relearning",function()
  local w,a=setup(deferred,4,{palette=8});local profile=a.GetPaletteProfile();w.recreatePalette(8);w.flush()
  assert(a.ImportPaletteData(profile));assert(a.GetPerformanceStats().BoundPaletteControls==8)
  a.SetMode("CIVIL WAR");w.start(a,3);assert(a.GetStats().Dirty==0 and a.GetPerformanceStats().PaletteSelectionFailures==0)
  a.Stop();w.assertClean()
 end)
 test(pre.."profile imported with missing GUI retains metadata until controls return",function()
  local w,a=setup(deferred,0,{palette=8});local profile=a.GetPaletteProfile();w.detachPalette();w.flush()
  assert(a.ImportPaletteData(profile));assert(a.GetPerformanceStats().LearnedPaletteColors==8 and a.GetPerformanceStats().CivilCapacity==0)
  w.recreatePalette(8);w.flush();assert(a.GetPerformanceStats().CivilCapacity==8);w.assertClean()
 end)
 test(pre.."focus loss plus GUI recreation requires resume and preserves assignments",function()
  local w,a,p=setup(deferred,3,{palette=8});a.SetMode("CIVIL WAR");w.start(a,2)
  local key=a.GetTargetStats(p[2]).AssignedCivilColorKey;w.input.WindowFocusReleased:Fire();w.flush();w.step(.2)
  w.recreatePalette(8);p[2].Color=w.Color3.new(0,0,0);w.flush();w.input.WindowFocused:Fire();w.flush()
  assert(not a.GetStats().Running and a.GetPerformanceStats().CivilCapacity==8)
  assert(a.GetTargetStats(p[2]).AssignedCivilColorKey==key);w.start(a,1)
  assert(a.GetStats().Dirty==0 and a.GetTargetStats(p[2]).AssignedCivilColorKey==key);a.Stop();w.assertClean()
 end)
 test(pre.."GUI replacement while Civil idle rebinds lazily before next correction",function()
  local w,a,p=setup(deferred,3,{palette=8});a.SetMode("CIVIL WAR");w.start(a,2)
  local target=a.GetTargetStats(p[3]).TargetColor;w.recreatePalette(8);p[3].Color=w.Color3.new(0,0,0);w.flush();w.step(1)
  assert(a.GetStats().Dirty==0 and a.ColorsMatch(p[3].Color,target))
  assert(a.GetPerformanceStats().PaletteSelectionFailures==0);a.Stop();w.assertClean()
 end)
 test(pre.."rebinding exports stats and bounded recovery evidence without automated input",function()
  local w,a=setup(deferred,0,{palette=128});w.recreatePalette(128);w.flush()
  local moves=w.cursorMoves;local n=#w.activationEvents
  local report=a.GetPerformanceReport()..a.GetColorDiagnostics()..a.GetPaletteInventory()
  for _,key in ipairs({"InputStateResyncs","TargetQuarantines","GlobalDwellMs","PaletteControlsRebound","LastPaletteRebindReason","BindingState","LastBoundGeneration"}) do assert(report:find(key,1,true),key) end
  assert(w.cursorMoves==moves and #w.activationEvents==n and a.GetStats().AutoPainterRPCs==0);w.assertClean()
 end)

 test(pre.."release failure after a qualified full window never trains NORMAL dwell",function()
  local w,a=setup(deferred,1);w.nativeRepeat=false;w.responses["VirtualInput.SendMouseButton"]={mouse=true,upThrow=true};w.start(a,1)
  local m=a.GetPerformanceStats();assert(m.ReleaseTimeouts==1 and m.GlobalDwellMs==120 and m.ValidNoEffectAttempts==0)
  local records=a.GetServiceRecords();assert(records[#records].Result=="RELEASE_RECOVERY" and not records[#records].FullWindowCompleted)
  assert(not a.GetStats().Running);w.assertClean()
 end)
 test(pre.."silent loss of held physical state is resynced without a valid-no-effect sample",function()
  local w,a=setup(deferred,1);w.nativeRepeat=false
  w.schedule(.06,function() w.button=false end);w.start(a,.18)
  local m=a.GetPerformanceStats();assert(m.InputStateResyncs==1 and m.SuccessfulInputResyncs==1 and m.ValidNoEffectAttempts==0)
  assert(m.GlobalDwellMs==120);a.Stop();w.step(.2);w.assertClean()
 end)
 test(pre.."missing palette during opener keeps assignment identity and restores on resume",function()
  local w,a,p=setup(deferred,2,{palette=4});local key=a.GetTargetStats(p[1]).AssignedCivilColorKey
  local opener,closer,show=w.makeChrome()
  show(false);assert(a.BeginPaletteLearning("OPENER"));w.humanSelect(opener);a.FinishPaletteLearning();show(false)
  w.onPaletteDown=function() w.detachPalette() end
  a.SetMode("CIVIL WAR");w.start(a,1)
  assert(a.GetStats().Running and a.GetPerformanceStats().LearnedPaletteColors==4)
  assert(a.GetTargetStats(p[1]).AssignedCivilColorKey==key and a.GetTargetStats(p[1]).AssignedColorName~=nil)
  w.onPaletteDown=nil;w.recreatePalette(4,true);w.flush();w.start(a,2)
  assert(a.GetStats().Dirty==0 and a.GetTargetStats(p[1]).AssignedCivilColorKey==key);a.Stop();w.assertClean()
 end)
 test(pre.."unfocused explicit start does not arm a silent worker",function()
  local w,a=setup(deferred,2);w.input.WindowFocusReleased:Fire();w.flush();w.start(a,.3)
  assert(not a.GetStats().Running and next(w.downs)==nil);w.input.WindowFocused:Fire();w.flush()
  assert(not a.GetStats().Running);w.start(a,1);assert(a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)
 test(pre.."repeated full GUI recreation retains capacity with no listener growth",function()
  local w,a=setup(deferred,0,{palette=8});local connections=w.connections
  for _=1,12 do w.recreatePalette(8);w.flush();assert(a.GetPerformanceStats().CivilCapacity==8) end
  assert(w.connections==connections and a.GetPerformanceStats().LearnedPaletteColors==8)
  assert(a.GetPerformanceStats().PaletteControlsRebound==96);w.assertClean()
 end)
 test(pre.."NORMAL and CIVIL timing evidence remain independent",function()
  local w,a=setup(deferred,8,{palette=8});w.start(a,2);assert(a.GetPerformanceStats().GlobalDwellMs<=160)
  a.Stop();w.step(.2);a.SetMode("CIVIL WAR");w.nativeRepeat=false;w.start(a,2)
  local m=a.GetPerformanceStats();assert(m.Strategies.PER_TARGET.DwellMs<=160 and m.Strategies.CIVIL_WAR.DwellMs==120)
  a.Stop();w.step(.2);w.assertClean()
 end)

