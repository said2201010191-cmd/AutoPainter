local Mock=require("./V7Mock")
local passed=0
local function test(name,fn)
 local ok,err=pcall(fn);assert(ok,"FAIL "..name..": "..tostring(err));passed+=1;print("PASS "..name)
end
local function setup(deferred,n,options)
 local w=Mock.new(deferred);options=options or {}
 if options.color then w.color=options.color(w);w.nativePaletteColor=w.color;w.player:SetAttribute("PaintBucketColor",w.color) end
 local a=w.load(SOURCE);w.protected={};local parts={}
 if options.palette then w.makePalette(options.palette);w.learn(a) end
 for i=1,n or 1 do
  local p=w.province((i-1)*40-120,0);p.Name="Province";parts[i]=p;w.protected[p]=true;assert(a.AddProvince(p))
 end
 w.mouse.Target=nil;return w,a,parts
end
for _,deferred in ipairs({false,true}) do
 local pre=deferred and "deferred " or "immediate "
 test(pre.."normalized matcher handles floats and exactly one RGB byte per channel",function()
  local w,a=setup(deferred,0)
  assert(a.ColorsMatch(w.Color3.new(0.50001,0.2,0.3),w.Color3.fromRGB(128,51,77)))
  assert(a.ColorsMatch(w.Color3.fromRGB(128,51,77),w.Color3.fromRGB(129,50,78)))
  assert(not a.ColorsMatch(w.Color3.fromRGB(128,51,77),w.Color3.fromRGB(130,51,77)))
  assert(not a.ColorsMatch(nil,w.color));w.assertClean()
 end)
