local Mock=require("./FastHoldMock")
local passed=0
local function test(name,fn)
	local ok,err=pcall(fn);assert(ok,"FAIL "..name..": "..tostring(err));passed+=1;print("PASS "..name)
end
local function setup(deferred,count)
	local w=Mock.new(deferred);local api=w.load(SOURCE);local parts={};w.protected={}
	for i=1,count or 3 do local p=w.province((i-1)*60,0);p.Name="Province"..i;api.AddProvince(p);parts[i]=p;w.protected[p]=true end
	w.mouse.Target=nil
	return w,api,parts
end
for _,deferred in ipairs({false,true}) do
 local pre=deferred and "deferred " or "immediate "
 test(pre.."confirmed VirtualInput is primary and many targets share one down",function()
	local w,a,parts=setup(deferred,3);w.start(a,1)
	for _,p in ipairs(parts) do assert(p.Color==w.color) end
	assert(w.downs["VirtualInput.SendMouseButton"]==1 and w.ups["VirtualInput.SendMouseButton"]==1)
	assert(not w.downs.mouse1press and not w.downs["Tool:Activate"])
	assert(a.GetPerformanceStats().SessionConfirmed and a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)
 test(pre.."visible targets use cursor and no camera search",function()
	local w,a=setup(deferred,3);local before=w.workspace.CurrentCamera.CFrame;w.start(a,1)
	assert(w.cursorMoves>=3 and w.workspace.CurrentCamera.CFrame==before)
	assert(a.GetPerformanceStats().FullCameraSearches==0);a.Stop();w.assertClean()
 end)
 test(pre.."clean protected provinces stay dormant with zero scans rays or input",function()
	local w,a,parts=setup(deferred,3);for _,p in ipairs(parts) do p.Color=w.color end;w.flush();w.start(a,0.5)
	local m=a.GetPerformanceStats();w.step(2);local n=a.GetPerformanceStats()
	assert(next(w.downs)==nil and m.QueueEvaluations==n.QueueEvaluations and n.Raycasts==0 and n.Candidates==0);a.Stop();w.assertClean()
 end)
 test(pre.."ColorChanged immediately queues and removes an entry",function()
	local w,a,parts=setup(deferred,1);w.start(a,0.6);assert(a.GetStats().Dirty==0)
	parts[1].Color=w.Color3.new(0,0,0);w.flush();assert(a.GetStats().Dirty==1)
	parts[1].Color=w.color;w.flush();assert(a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)
 test(pre.."recolor wakes idle without retesting activation methods",function()
	local w,a,parts=setup(deferred,1);w.start(a,0.6);local probes=w.virtualDiscoveries
	parts[1].Color=w.Color3.new(0,0,0);w.flush();w.step(0.4)
	assert(parts[1].Color==w.color and w.virtualDiscoveries==probes and not w.downs.mouse1press)
	assert(a.GetPerformanceStats().CachedCursorHits>0);a.Stop();w.assertClean()
 end)
 test(pre.."a stalled target is deferred within the short watchdog",function()
	local w,a,p=setup(deferred,3);w.stalled={[p[1]]=true};w.start(a,0.7)
	assert(p[2].Color==w.color and p[3].Color==w.color and p[1].Color~=w.color)
	assert(a.GetPerformanceStats().Stalled>0 and not w.downs.mouse1press);a.Stop();w.assertClean()
 end)
 test(pre.."stalls alone never cause activation method discovery",function()
	local w,a,p=setup(deferred,2);w.stalled={[p[1]]=true,[p[2]]=true};w.start(a,4)
	assert(not w.downs.mouse1press and not w.downs["Tool:Activate"])
	assert(a.GetPerformanceStats().Stalled>2);a.Stop();w.assertClean()
 end)
 test(pre.."success event switches before the no-effect timeout",function()
	local w,a,p=setup(deferred,3);w.nativeInterval=0.02;w.start(a,0.8)
	local m=a.GetPerformanceStats();assert(m.Corrections==3 and m.AverageSwitchMs<100 and m.AverageAcquiredToColorMs<100);a.Stop();w.assertClean()
 end)
 test(pre.."correction during a yielding cursor move is counted once without another down",function()
	local w,a=setup(deferred,3);w.paintDuringCursor=true;w.start(a,0.8)
	local m=a.GetPerformanceStats()
	assert(m.Corrections==3 and m.Acquisitions==3 and m.DirtyCount==0)
	assert(w.downs["VirtualInput.SendMouseButton"]==1 and m.AverageAcquiredToColorMs>=0)
	a.Stop();w.assertClean()
 end)
 test(pre.."STOP releases the single owned hold",function()
	local w,a,p=setup(deferred,2);w.stalled={[p[1]]=true,[p[2]]=true};w.start(a,0.18);a.Stop();w.step(0.5)
	assert(not a.GetStats().Held and not a.GetStats().Running and w.activeMethod==nil);w.assertClean()
 end)
 test(pre.."focus loss releases and creates no additional down",function()
	local w,a,p=setup(deferred,2);w.stalled={[p[1]]=true,[p[2]]=true};w.start(a,0.18)
	w.input.WindowFocusReleased:Fire();w.step(0.5);assert(not a.GetStats().Running and w.activeMethod==nil);w.assertClean()
 end)
 test(pre.."Clear removes queue highlights listeners and held input",function()
	local w,a,p=setup(deferred,3);w.start(a,0.18);a.Clear();w.step(0.5)
	assert(a.GetStats().Dirty==0 and a.GetStats().Selected==0 and not a.GetStats().Held)
	for _,part in ipairs(p) do part.Color=w.Color3.new(0,1,0) end;w.flush();assert(a.GetStats().Dirty==0);w.assertClean()
 end)
 test(pre.."removal and destruction swap-remove all tracking entries",function()
	local w,a,p=setup(deferred,3);a.RemoveProvince(p[2]);p[1]:Destroy();w.flush()
	assert(a.GetStats().Selected==1 and a.GetTargetStats(p[2])==nil);w.start(a,0.7);assert(p[3].Color==w.color);a.Stop();w.assertClean()
 end)
 test(pre.."CIVIL WAR keeps unique colors and releases across palettes",function()
	local w,a,p=setup(deferred,2);a.SetMode("CIVIL WAR");w.start(a,1.2)
	assert(p[1].Color~=p[2].Color and a.GetStats().Dirty==0)
	assert(w.downs["VirtualInput.SendMouseButton"]==2 and w.ups["VirtualInput.SendMouseButton"]==2);w.env.task.spawn(a.Stop);w.step(0.3);w.assertClean()
 end)
 test(pre.."projection ray and transition work is bounded",function()
	local w,a,p=setup(deferred,100);w.start(a,0.16)
	local m=a.GetPerformanceStats();w.step(1/60);local n=a.GetPerformanceStats()
	assert(n.Projections-m.Projections<=96 and n.Raycasts-m.Raycasts<=32)
	a.Stop();w.step(0.2);w.assertClean()
 end)
 test(pre.."external unprotected color changes are ignored",function()
	local w,a=setup(deferred,1);local p=w.province(250,0);w.start(a,0.6);local m=a.GetPerformanceStats()
	p.Color=w.color;p.Color=w.Color3.new(0,1,0);w.flush()
	assert(a.GetPerformanceStats().QueueEvaluations==m.QueueEvaluations and a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)
 test(pre.."palette preparation is not repeated in NORMAL",function()
	local w,a=setup(deferred,3);w.start(a,0.7);assert(w.attributeWrites==2);a.Stop();w.assertClean()
 end)
 test(pre.."failed native down has paired release and bounded recovery",function()
	local w,a=setup(deferred,1);w.responses["VirtualInput.SendMouseButton"]={throw=true}
	w.responses.mouse1press={mouse=true,paint=true};w.start(a,3)
	assert(w.downs["VirtualInput.SendMouseButton"]==3 and w.downs.mouse1press==1);a.Stop();w.assertClean()
 end)
 test(pre.."missing down observation triggers recovery only after repeated failure",function()
	local w,a=setup(deferred,1);w.responses["VirtualInput.SendMouseButton"]={};w.nativeRepeat=false
	w.responses.mouse1press={mouse=true,paint=true};w.start(a,3)
	assert(w.downs["VirtualInput.SendMouseButton"]==3 and w.downs.mouse1press==1);a.Stop();w.assertClean()
 end)
 test(pre.."missing observed release blocks further cursor and input ownership",function()
	local w,a=setup(deferred,1);w.responses["VirtualInput.SendMouseButton"]={mouse=true,noUp=true};w.start(a,1)
	assert(not a.GetStats().Running and w.downs["VirtualInput.SendMouseButton"]==1);w.assertClean()
 end)
 test(pre.."telemetry export never generates input",function()
	local w,a=setup(deferred,2);w.start(a,0.8);local n=w.cursorMoves
	local report=a.GetPerformanceReport();assert(report:find("AverageAcquiredToColorMs",1,true) and report:find("VirtualInputHold",1,true))
	assert(w.cursorMoves==n);a.Stop();w.assertClean()
 end)
 test(pre.."START is serialized and STOP cancels pending preparation",function()
	local w,a=setup(deferred,1);w.env.task.spawn(a.Start);assert(a.Start()==false);a.Stop();w.step(1)
	assert(next(w.downs)==nil and not a.GetStats().Running);w.assertClean()
 end)
 test(pre.."duplicate loader cannot create an input competitor",function()
	local w,a=setup(deferred,1);assert(w.load(SOURCE)==a);a.Stop();w.assertClean()
 end)
 test(pre.."respawn releases and stops the previous tool session",function()
	local w,a,p=setup(deferred,2);w.stalled={[p[1]]=true,[p[2]]=true};w.start(a,0.18)
	w.player.Character=nil;w.step(0.5);assert(not a.GetStats().Running and not a.GetStats().Held);w.assertClean()
 end)
 test(pre.."cached points refresh on part geometry changes",function()
	local w,a,p=setup(deferred,1);w.start(a,0.7);local old=a.GetTargetStats(p[1]).LastWorldPoint
	p[1].Position=w.v(100,0,0);p[1].CFrame=w.env.CFrame.lookAt(p[1].Position,p[1].Position+w.v(0,0,1))
	p[1].Color=w.Color3.new(0,0,0);w.flush();w.step(0.5)
	assert(a.GetTargetStats(p[1]).LastWorldPoint~=old and p[1].Color==w.color);a.Stop();w.assertClean()
 end)
 test(pre.."offscreen recovery releases before reusing camera alignment",function()
	local w,a,p=setup(deferred,1);local q=w.province(1100,0);a.AddProvince(q);w.protected[q]=true
	w.start(a,1.8)
	assert(p[1].Color==w.color and q.Color==w.color)
	assert(a.GetPerformanceStats().FullCameraSearches>=1 and w.downs["VirtualInput.SendMouseButton"]==2)
	assert(w.violations==0);a.Stop();w.assertClean()
 end)
 test(pre.."successful camera pose is reused before another full search",function()
	local w,a,p=setup(deferred,1);p[1].Position=w.v(1100,0,0);p[1].CFrame=w.env.CFrame.lookAt(p[1].Position,p[1].Position+w.v(0,0,1))
	w.start(a,1.5);local full=a.GetPerformanceStats().FullCameraSearches
	w.workspace.CurrentCamera.CFrame=w.cf(w.v(0,100,0));p[1].Color=w.Color3.new(0,0,0);w.flush();w.step(0.8)
	assert(p[1].Color==w.color and a.GetPerformanceStats().CachedCameraHits>=1)
	assert(a.GetPerformanceStats().FullCameraSearches==full);a.Stop();w.assertClean()
 end)
 test(pre.."a delayed real cursor target is verified without repeated down",function()
	local w,a=setup(deferred,3);w.cursorDelay=0.02;w.start(a,1.2)
	assert(a.GetStats().Dirty==0 and w.downs["VirtualInput.SendMouseButton"]==1);a.Stop();w.assertClean()
 end)
 test(pre.."cache candidates have priority over ordinary visible candidates",function()
	local w,a,p=setup(deferred,1);w.start(a,0.6);a.Stop();w.step(0.2)
	local q=w.province(150,0);a.AddProvince(q);p[1].Color=w.Color3.new(0,0,0);w.flush()
	local n=#w.activationEvents;w.start(a,0.8)
	for i=n+1,#w.activationEvents do local e=w.activationEvents[i];if e.kind=="down" then assert(e.part==p[1]);break end end
	assert(q.Color==w.color);a.Stop();w.assertClean()
 end)
 test(pre.."nearest visible point is chosen when cache tiers are equal",function()
	local w,a,p=setup(deferred,2);w.cursor=w.v(460,300);w.start(a,0.7)
	assert(w.activationEvents[1].part==p[2]);a.Stop();w.assertClean()
 end)
 test(pre.."temporary deferral resets after a target becomes correct",function()
	local w,a,p=setup(deferred,1);w.stalled={[p[1]]=true};w.start(a,0.7)
	assert(a.GetTargetStats(p[1]).RecentFailures>0)
	p[1].Color=w.color;w.flush();assert(a.GetTargetStats(p[1]).RecentFailures==0 and a.GetTargetStats(p[1]).RetryAt==0)
	a.Stop();w.assertClean()
 end)
 test(pre.."repeated selection clear cycles leave no stale listeners or queue state",function()
	local w,a=setup(deferred,0);local baseline=w.connections
	for _=1,10 do
		local batch={};for i=1,20 do local part=w.province(i*10,0);table.insert(batch,part);assert(a.AddProvince(part)) end
		a.Clear();w.flush();for _,part in ipairs(batch) do part.Color=w.color end;w.flush()
		assert(w.connections==baseline and a.GetStats().Selected==0 and a.GetStats().Dirty==0)
	end;w.assertClean()
 end)
 test(pre.."normal palette changes stop instead of painting toward stale authority",function()
	local w,a,p=setup(deferred,1);w.stalled={[p[1]]=true};w.start(a,0.18)
	w.player:SetAttribute("PaintBucketColor",w.Color3.new(0,1,0));w.flush();w.step(0.4)
	assert(not a.GetStats().Running and w.activeMethod==nil);w.assertClean()
 end)
 test(pre.."tool loss releases an active continuous hold",function()
	local w,a,p=setup(deferred,1);w.stalled={[p[1]]=true};w.start(a,0.18);w.bucket.Parent=nil;w.flush();w.step(0.4)
	assert(not a.GetStats().Running and w.activeMethod==nil);w.assertClean()
 end)
 test(pre.."queued target removal cannot produce a later activation",function()
	local w,a,p=setup(deferred,2);a.RemoveProvince(p[2]);w.start(a,0.8)
	assert(p[2].Color~=w.color and a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)
 test(pre.."unprotected real target during a warp causes immediate release",function()
	local w,a,p=setup(deferred,2);local intruder=w.province(250,0)
	w.start(a,0.16);w.badCursorTarget=intruder;w.step(0.3)
	assert((w.ups["VirtualInput.SendMouseButton"] or 0)>=1);a.Stop();w.assertClean()
 end)
 test(pre.."close during a yielding primary down serializes release",function()
	local w,a=setup(deferred,1);w.responses["VirtualInput.SendMouseButton"]={mouse=true,delay=0.3}
	w.start(a,0.18);a.Destroy();w.step(1)
	assert(w.activeMethod==nil and w.ups["VirtualInput.SendMouseButton"]==1);w.assertClean()
 end)
 test(pre.."interactive menu blocks activation without remote or signal spoof",function()
	local w,a=setup(deferred,1);w.gui.MenuIsOpen=true;w.start(a,0.4)
	assert(next(w.downs)==nil);a.Stop();w.assertClean()
 end)
 test(pre.."no-effect recovery keeps confirmed virtual method cached",function()
	local w,a,p=setup(deferred,1);w.start(a,0.6)
	w.stalled={[p[1]]=true};p[1].Color=w.Color3.new(0,0,0);w.flush();w.step(4)
	assert(a.GetPerformanceStats().SessionConfirmed and w.virtualDiscoveries==1 and not w.downs.mouse1press);a.Stop();w.assertClean()
 end)
 test(pre.."correctness event removes all dirty work before the next input cycle",function()
	local w,a,p=setup(deferred,3);w.start(a,0.18)
	for _,part in ipairs(p) do part.Color=w.color end;w.flush();w.step(0.3)
	local n=#w.activationEvents;w.step(1);assert(#w.activationEvents==n and a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)
 test(pre.."confirmed session does not rerun source discovery or palette writes per target",function()
	local w,a=setup(deferred,5);w.forbidSourceRead=true;local before=w.attributeWrites;w.start(a,1.2)
	assert(w.descendantReads==0 and w.virtualDiscoveries==1 and w.attributeWrites-before==1)
	assert(a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)

 test(pre.."unexpected native up stops instead of pretending the hold continues",function()
	local w,a,p=setup(deferred,1);w.stalled={[p[1]]=true};w.start(a,0.18);w.manualUp();w.step(0.5)
	assert(not a.GetStats().Running and not a.GetPerformanceStats().VirtualInputHold);w.assertClean()
 end)
 test(pre.."late observed up finishes closed-controller cleanup",function()
	local w,a,p=setup(deferred,1);w.stalled={[p[1]]=true};w.responses["VirtualInput.SendMouseButton"]={mouse=true,noUp=true}
	w.start(a,0.18);a.Destroy();w.step(0.6);w.manualUp();w.step(0.2)
	assert(not w.playerGui:FindFirstChild("AutoPainterHandsFreeUI"));w.assertClean()
 end)

end
print(passed.." hands-free fast-hold tests passed (mock native loop; not a live throughput claim)")
