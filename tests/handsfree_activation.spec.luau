  p[1].Color=w.Color3.new(0,1,0);w.flush();local after=a.GetTargetStats(p[1])
  assert(after.RetryAt==before.RetryAt and after.FreshAttackAt==before.FreshAttackAt and after.DirtySince==before.DirtySince)
  assert(after.LastWrongColorChange==w.now);a.Stop();w.assertClean()
 end)
