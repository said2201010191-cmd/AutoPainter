local Mock=require("./HandsFreeMock")
local passed=0
local function check(w)
	assert(#w.errors==0,table.concat(w.errors,"\n"))
	assert(w.networkAttempts==0,"AutoPainter called game remote")
end
local function setup(deferred)
	local w=Mock.new(deferred);local p=w.province(0,0);w.mouse.Target=p
	local api=w.load(SOURCE);assert(api.AddProvince(p));return w,api,p
end
local function test(name,fn)
	local ok,err=pcall(fn)
	assert(ok,"FAIL "..name..": "..tostring(err));passed+=1;print("PASS "..name)
end
for _,deferred in ipairs({false,true}) do
	local prefix=deferred and "deferred " or "immediate "
	test(prefix.."mouse input and target color verify a route with no physical clicks",function()
		local w,a,p=setup(deferred);w.responses.mouse1press={mouse=true,paint=true};w.begin(a);w.step(1)
		assert(p.Color==w.color and w.downs.mouse1press==1 and not w.downs["Tool:Activate"])
		assert(a.GetStats().Activation.Observed and a.GetStats().Activation.ColorChanged);a.Stop();check(w)
	end)
	test(prefix.."no-op mouse1press falls back to official virtual input sequentially",function()
		local w,a,p=setup(deferred);w.virtualAvailable=true;w.responses["VirtualInput.SendMouseButton"]={mouse=true,paint=true}
		w.begin(a);w.step(2)
		assert(w.downs.mouse1press==1 and w.ups.mouse1press==1 and w.downs["VirtualInput.SendMouseButton"]==1)
		assert(p.Color==w.color and a.GetStats().Activation.Method=="VirtualInput.SendMouseButton");a.Stop();check(w)
	end)
	test(prefix.."Tool Activate can qualify only with observable color effect",function()
		local w,a,p=setup(deferred);w.responses["Tool:Activate"]={tool=true,paint=true};w.begin(a);w.step(2)
		assert(p.Color==w.color and a.GetStats().Activation.Observation=="Tool.Activated only")
		assert(a.GetStats().Activation.Preferred=="Tool:Activate");a.Stop();check(w)
	end)
	test(prefix.."Tool Activated without paint is not treated as handler success",function()
		local w,a=setup(deferred);w.begin(a);w.step(3)
		assert(not a.GetStats().Running and a.GetStats().Activation.Preferred==nil)
		assert(a.GetActivationReport():find("No available activation method",1,true))
		local count=w.downs["Tool:Activate"];w.step(10);assert(w.downs["Tool:Activate"]==count);check(w)
	end)
	test(prefix.."input acknowledgment alone does not qualify mouse route",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true};w.begin(a);w.step(3)
		assert(not a.GetStats().Running and a.GetStats().Corrections==0);check(w)
	end)
	test(prefix.."unrelated color without input observation does not qualify",function()
		local w,a,p=setup(deferred);w.responses.mouse1press={paint=true};w.begin(a);w.step(2)
		assert(a.GetStats().Activation.Preferred==nil);assert(w.downs.mouse1press==1);a.Stop();check(w)
	end)
	test(prefix.."wrong color change does not qualify",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true,paint=true,wrongColor=w.Color3.new(0,1,0)}
		w.begin(a);w.step(3);assert(not a.GetStats().Running and not a.GetStats().Activation.Preferred);check(w)
	end)
	test(prefix.."missing native functions do not block tool activation",function()
		local w,a,p=setup(deferred);w.env.mouse1press=nil;w.env.mouse1release=nil
		w.responses["Tool:Activate"]={paint=true};w.begin(a);w.step(2)
		assert(p.Color==w.color and w.downs.mouse1press==nil);a.Stop();check(w)
	end)
	test(prefix.."denied virtual input is recorded not bypassed",function()
		local w,a=setup(deferred);w.virtualDenied=true;w.begin(a);w.step(3)
		assert(a.GetActivationReport():find("VirtualInput: unavailable/denied",1,true));check(w)
	end)
	test(prefix.."Tool Equipped Mouse signal is observed separately",function()
		local w,a,p=setup(deferred);w.responses.mouse1press={equippedMouse=true,paint=true};w.begin(a);w.step(1)
		assert(p.Color==w.color and a.GetStats().Activation.Observation=="Mouse.Button1Down");a.Stop();check(w)
	end)
	test(prefix.."delayed up prevents next route from activating early",function()
		local w,a,p=setup(deferred);w.responses.mouse1press={mouse=true,upDelay=0.2};w.responses["Tool:Activate"]={paint=true}
		w.begin(a);w.step(3);assert(p.Color==w.color)
		local up,nextDown
		for _,e in ipairs(w.activationEvents) do
			if e.kind=="up" and e.method=="mouse1press" then up=e.at end
			if e.kind=="down" and e.method=="Tool:Activate" then nextDown=e.at end
		end
		assert(nextDown-up>=0.2);a.Stop();check(w)
	end)
	test(prefix.."missing release event blocks fallback rather than overlap",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true,noUp=true};w.begin(a);w.step(3)
		assert(not a.GetStats().Running and not w.downs["Tool:Activate"])
		assert(a.GetActivationReport():find("Release unconfirmed",1,true));check(w)
	end)
	test(prefix.."API error is released before fallback",function()
		local w,a,p=setup(deferred);w.responses.mouse1press={throw=true};w.responses["Tool:Activate"]={paint=true}
		w.begin(a);w.step(2);assert(p.Color==w.color and w.ups.mouse1press==1);a.Stop();check(w)
	end)
	test(prefix.."same verified method is reused for second dirty target",function()
		local w,a,p=setup(deferred);local b=w.province(60,0);a.AddProvince(b)
		w.responses["Tool:Activate"]={paint=true};w.begin(a);w.step(3)
		assert(p.Color==w.color and b.Color==w.color and w.downs.mouse1press==1 and w.downs["Tool:Activate"]==2)
		a.Stop();check(w)
	end)
	test(prefix.."no-effect on previously confirmed route has finite retries",function()
		local w,a,p=setup(deferred);w.responses.mouse1press={mouse=true,paint=true};w.begin(a);w.step(1)
		w.responses.mouse1press={mouse=true};p.Color=w.Color3.new(0,0,0);w.step(6)
		assert(not a.GetStats().Running and w.downs.mouse1press==4);check(w)
	end)
	test(prefix.."target loss releases and never activates off cursor",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true,paintDelay=0.5,paint=true};w.begin(a)
		w.mouse.Target=nil;w.step(0.04);assert(w.ups.mouse1press==1);a.Stop();check(w)
	end)
	test(prefix.."stop during yielding down serializes release",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true,delay=0.3}
		w.begin(a);a.Stop();w.step(1)
		assert(not a.GetStats().Running and w.ups.mouse1press==1 and w.activeMethod==nil);check(w)
	end)
	test(prefix.."source read failures are honest and scripts are not executed",function()
		local w,a=setup(deferred);local script=w.instance("LocalScript");script.Parent=w.bucket;w.forbidSourceRead=true
		w.begin(a);w.step(3);assert(a.GetActivationReport():find("unavailable=1",1,true));check(w)
	end)
	test(prefix.."readable activation mentions are reported without requiring source",function()
		local w,a=setup(deferred);local script=w.instance("LocalScript");script.Parent=w.bucket
		script.Source="mouse.Button1Down:Connect(paint) tool.Activated:Connect(paint)"
		w.begin(a);w.step(3);assert(a.GetActivationReport():find("Button1Down mentions=1 Activated mentions=1",1,true));check(w)
	end)
	test(prefix.."normal and optional civil war retain target color behavior",function()
		local w,a,p=setup(deferred);a.SetMode("CIVIL WAR");w.responses["Tool:Activate"]={paint=true};w.begin(a);w.step(2)
		assert(p.Color~=w.color and a.GetStats().Corrections==1 and a.GetStats().Mode=="CIVIL WAR");a.Stop();w.step(0.5);check(w)
	end)
	test(prefix.."copy exports existing evidence without input",function()
		local w,a=setup(deferred);w.env.setclipboard=function(t) w.clipboard=t end
		assert(a.CopyActivationReport());assert(w.clipboard:find("Activation attempted=false",1,true));assert(next(w.downs)==nil);check(w)
	end)
	test(prefix.."already correct target never triggers an activation probe",function()
		local w,a,p=setup(deferred);p.Color=w.color;w.begin(a);w.step(1)
		assert(next(w.downs)==nil);a.Stop();check(w)
	end)
	test(prefix.."failed down and inert release errors can safely continue",function()
		local w,a,p=setup(deferred)
		w.env.mouse1press=function() w.downs.mouse1press=1;error("API unavailable") end
		w.env.mouse1release=function() error("Already released") end
		w.responses["Tool:Activate"]={paint=true};w.begin(a);w.step(2)
		assert(p.Color==w.color and w.downs["Tool:Activate"]==1);a.Stop();check(w)
	end)
	test(prefix.."release errors following real down do not allow fallback",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true,upThrow=true};w.begin(a);w.step(3)
		assert(not a.GetStats().Running and not w.downs["Tool:Activate"] and w.ups.mouse1press==1);check(w)
	end)
	test(prefix.."duplicate loader shares the input controller",function()
		local w,a=setup(deferred);local b=w.load(SOURCE);assert(a==b);a.Stop();check(w)
	end)
	test(prefix.."concurrent START during preparation cannot launch two workers",function()
		local w,a,p=setup(deferred);w.responses.mouse1press={mouse=true,paint=true}
		w.env.task.spawn(a.Start);local again=a.Start();assert(again==false)
		w.step(2);assert(p.Color==w.color and w.downs.mouse1press==1);a.Stop();check(w)
	end)
	test(prefix.."STOP during START setup cancels before any activation",function()
		local w,a=setup(deferred);w.env.task.spawn(a.Start);a.Stop();w.step(2)
		assert(not a.GetStats().Running and next(w.downs)==nil);check(w)
	end)
	test(prefix.."START replaces input-consuming controls with noninteractive diagnostics",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true,paint=true};w.begin(a)
		local button=w.findText("STOP AUTO");assert(button and button.Parent.Visible==false)
		local hud=w.playerGui:FindFirstChild("AutoPainterHandsFreeUI"):FindFirstChild("ActivationLiveStatus")
		assert(hud.Visible and hud.Active==false);a.Stop();w.step(0.2);assert(button.Parent.Visible);check(w)
	end)
	test(prefix.."closure during yielding press drains release before discarding observers",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true,delay=0.3};w.begin(a);a.Destroy();w.step(1)
		assert(w.ups.mouse1press==1 and w.activeMethod==nil)
		assert(not w.playerGui:FindFirstChild("AutoPainterHandsFreeUI"));check(w)
	end)
	test(prefix.."respawn stops and releases existing activation",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true};w.begin(a);w.player.Character=nil;w.step(1)
		assert(not a.GetStats().Running and w.ups.mouse1press==1 and not w.downs["Tool:Activate"]);check(w)
	end)
	test(prefix.."focus loss stops instead of pressing outside the client",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true};w.begin(a)
		w.input.WindowFocusReleased:Fire();w.step(1)
		assert(not a.GetStats().Running and w.activeMethod==nil);check(w)
	end)
	test(prefix.."Clear cancels held activation and stops future work",function()
		local w,a=setup(deferred);w.responses.mouse1press={mouse=true};w.begin(a);a.Clear();w.step(2)
		assert(a.GetStats().Selected==0 and not a.GetStats().Running and w.ups.mouse1press==1);check(w)
	end)
	test(prefix.."report has writefile fallback and bounded trial results",function()
		local w,a=setup(deferred);w.env.writefile=function(path,t) w.savedPath,w.savedText=path,t end
		for _=1,6 do w.begin(a);w.step(3) end
		assert(a.CopyActivationReport() and w.savedPath=="AutoPainterActivationReport.txt")
		assert(#w.savedText<6000 and w.savedText:find("Activation observed=",1,true));check(w)
	end)

end
print(passed.." hands-free activation tests passed (mock only; no live activation claim)")
