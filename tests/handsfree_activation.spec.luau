 test(pre.."recent recolor jumps ahead of ordinary dirty traversal",function()
	local w,a,p=setup(deferred,50,"PER_TARGET")
	for i,part in ipairs(p) do local x,z=((i-1)%10)*40,math.floor((i-1)/10)*40;part.Position=w.v(x,0,z);part.CFrame=w.cf(part.Position) end
