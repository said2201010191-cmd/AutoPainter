	p[2].Color=w.Color3.new(0,0,0);w.flush()
	local d=a.GetTargetStats(p[2]);local m=a.GetPerformanceStats()
	assert(d.Dirty and d.LastColorEventTime==now and d.DirtyQueueInsertTime==now and d.DirtySince==now)
	assert(m.DirtyEventsWithoutHover>=1 and m.AverageColorEventToDirtyQueueMs<1)
	local report=a.GetDirtyEventReport();assert(report:find("Hovered at event=false",1,true) and report:find("Dirty queued=true",1,true))
	w.step(0.3);assert(a.GetStats().Dirty==0);a.Stop();w.assertClean()
 end)
