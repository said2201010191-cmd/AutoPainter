  assert(a.ColorsMatch(w.Color3.fromRGB(128,51,77),w.Color3.fromRGB(129,50,78)))
  assert(not a.ColorsMatch(w.Color3.fromRGB(128,51,77),w.Color3.fromRGB(130,51,77)))
  assert(not a.ColorsMatch(nil,w.color));w.assertClean()
 end)
