-- Behavioral regressions for fast dirty-only native control; run under both event models.
local function named(w,name)
	for _,o in ipairs(w.objects) do if o.Name==name and o:IsDescendantOf(w.playerGui) then return o end end
	error("Missing UI "..name)
end
local function clickEvent(w,kind,x,y)
	w.cursor=w.v(x,y)
	w.input[kind]:Fire({UserInputType=w.env.Enum.UserInputType.MouseButton1},false);w.flush()
end
for _,deferred in ipairs({false,true}) do
	local prefix=deferred and "deferred fast: " or "immediate fast: "
	test(prefix.."FAST is default and NORMAL changes only bounded input timings",function()
		local w,api=start(deferred);local t=api.GetTiming()
		assert(api.GetStats().SpeedMode=="FAST" and api.GetStats().Dwell==.32)
		assert(t.ReleaseGap==.05 and t.AimTimeout==1.05 and t.AimRetry==.12 and t.CursorInterval==.016)
		assert(t.TargetStableSeconds==0 and t.TargetStableFrames==1 and t.IdleRetry==.03 and t.CandidatesPerFrame==128 and t.MaxDwell==2)
		t.ReleaseGap=100;assert(api.GetTiming().ReleaseGap==.05)
		button(w,"Speed Mode: FAST");assert(api.GetStats().SpeedMode=="NORMAL" and api.GetTiming().TargetStableFrames==2)
		assert(not api.SetSpeedMode("unbounded") and #w.nativeEvents==0);zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."correct protected and unprotected parts are never targeted even when closest",function()
		local w,api=start(deferred);local wrong=add(w,api,1)[1];verify(w,api,wrong)
		local clean=w.province(80);clean.Color=api.GetDesiredColor();api.AddProvince(clean);api.CommitSelections()
		local outside=w.province(110);w.cursor=w.v(510,300)
		local n=#w.nativeEvents;api.SetPainting(true);w.step(6)
		for i=n+1,#w.nativeEvents do local e=w.nativeEvents[i];if e.kind=="down" then assert(e.part==wrong) end end
		assert(api.GetStats().Protected==2 and api.GetStats().WrongColor==1 and api.GetStats().CorrectColor==1)
		outside.Color=api.GetDesiredColor();w.flush();assert(api.GetStats().Protected==2)
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."Color signals immediately update dirty counts and wake an idle controller",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		p.Color=api.GetDesiredColor();w.flush();api.SetPainting(true);w.step(5)
		local events=#w.nativeEvents;local rays=w.rayCount
		w.step(20);assert(#w.nativeEvents==events and w.rayCount==rays)
		p.Color=w.Color3.new(1,0,0);w.flush();assert(api.GetStats().Dirty==1)
		waitHold(w,api);p.Color=api.GetDesiredColor();w.flush()
		assert(api.GetStats().Dirty==0 and not w.button and api.GetStats().CorrectColor==1)
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."a target cleaned after selection but before press receives no down or camera move",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		local downs=w.eventCount("down");w.staleMouse=true;w.mouse.Target=nil;api.SetPainting(true);w.step(.017)
		p.Color=api.GetDesiredColor();local camera=w.workspace.CurrentCamera.CFrame
		w.flush();local moves=w.eventCount("move");w.step(3)
		assert(w.eventCount("down")==downs and w.eventCount("move")==moves and w.workspace.CurrentCamera.CFrame==camera)
		zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."early color match releases before maximum dwell and immediately advances",function()
		local w,api=start(deferred);local parts=add(w,api,2);verify(w,api,parts[1])
		api.SetPainting(true);waitHold(w,api);local target=api.GetStats().Target;local at=w.now
		w.step(.05);target.Color=api.GetDesiredColor();w.flush()
		assert(not w.button and w.now-at<.45);waitHold(w,api)
		assert(api.GetStats().Target~=target and w.now-at<.35)
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."visible dirty wins over ordinary offscreen work and avoids camera rotation",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		local far=w.province(2000);api.AddProvince(far);api.CommitSelections()
		local frame=w.workspace.CurrentCamera.CFrame
		api.SetPainting(true);waitHold(w,api)
		assert(api.GetStats().Target==p and w.workspace.CurrentCamera.CFrame==frame)
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."nearest genuine visible cursor target wins an otherwise equal choice",function()
		local w,api=start(deferred);local parts=add(w,api,3);verify(w,api,parts[1])
		w.cursor=w.v(501,300);api.SetPainting(true);waitHold(w,api)
		assert(api.GetStats().Target==parts[3]);zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."smaller camera rotation wins between offscreen choices with equal waiting",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p);p.Color=api.GetDesiredColor()
		local nearer=w.province(500);local farther=w.province(2000)
		api.AddProvince(nearer);api.AddProvince(farther);api.CommitSelections();w.flush()
		api.SetPainting(true);waitHold(w,api);assert(api.GetStats().Target==nearer)
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."occluded visible projection is not treated as a targetable province",function()
		local w,api=start(deferred);local parts=add(w,api,2);verify(w,api,parts[1])
		w.occluded={[parts[1]]=true};api.SetVisibleOnly(true);api.SetPainting(true);waitHold(w,api)
		assert(api.GetStats().Target==parts[2]);zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."persistent camera goes directly between targets and stays put when clean",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p);p.Color=api.GetDesiredColor()
		local a,b=w.province(2000),w.province(2050);api.AddProvince(a);api.AddProvince(b);api.CommitSelections();w.flush()
		local camera=w.workspace.CurrentCamera;local original=camera.CFrame
		api.SetPainting(true);waitHold(w,api);local current=api.GetStats().Target;local automated=camera.CFrame
		assert(automated~=original);current.Color=api.GetDesiredColor();w.flush();waitHold(w,api)
		assert(camera.CFrame==automated and api.GetStats().Target~=current)
		api.GetStats().Target.Color=api.GetDesiredColor();w.flush();w.step(3)
		assert(camera.CFrame==automated and api.GetStats().Dirty==0)
		api.EmergencyStop();w.step(.3);assert(camera.CFrame==original);zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."contention increases hold cap gradually but never above two seconds",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		for i=1,5 do p.Color=api.GetDesiredColor();w.flush();p.Color=w.Color3.new(i/10,0,0);w.flush() end
		api.SetPainting(true);waitHold(w,api);local cap=api.GetStats().HoldLimit
		assert(cap>=.7 and cap<=1);api.EmergencyStop();w.step(.3)
		api.SetPriority(p);api.SetPainting(true);waitHold(w,api);assert(api.GetStats().HoldLimit==1)
		p.Color=api.GetDesiredColor();w.flush();assert(not w.button);zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."bounded aging eventually services an offscreen province under visible contention",function()
		local w,api=start(deferred);local parts=add(w,api,3);verify(w,api,parts[1])
		local far=w.province(2000);api.AddProvince(far);api.CommitSelections();api.SetPainting(true);w.step(18)
		local seen={};for _,e in ipairs(w.nativeEvents) do if e.kind=="down" then seen[e.part]=true end end
		assert(seen[far]);for _,p in ipairs(parts) do assert(seen[p]) end
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."surface cache rebuilds when a selected part moves and resizes",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		local transforms=w.pointTransforms
		api.SetPainting(true);waitHold(w,api);assert(w.pointTransforms==transforms)
		api.EmergencyStop();w.step(.3)
		p.Position=w.v(150,0,0);p.CFrame=w.cf(p.Position);p.Size=w.v(40,1,40)
		api.SetPainting(true);waitHold(w,api);assert(w.mouse.Target==p and w.pointTransforms==transforms+api.GetTargetStats(p).SampleCount)
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."visibility rays are bounded per frame even across a large blocked selection",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		for i=1,160 do local q=w.province((i%10)*30,math.floor(i/10)*10);api.AddProvince(q) end
		api.CommitSelections();w.forceMiss=true;api.SetPainting(true)
		for _=1,30 do local before=w.rayCount;w.step(1/60);assert(w.rayCount-before<=32) end
		api.Clear();w.step(1);assert(api.GetStats().Dirty==0);zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."palette at start overrides previews and no attributes are written between targets",function()
		local w,api=start(deferred);local parts=add(w,api,2);verify(w,api,parts[1])
		local red=w.Color3.new(1,0,0);w.player:SetAttribute("PaintBucketColor",red);w.flush()
		api.SetColor(w.Color3.new(0,0,1));local writes=w.attributeWrites
		api.SetPainting(true);waitHold(w,api);assert(api.GetDesiredColor()==red)
		w.step(3);assert(w.attributeWrites==writes)
		for _,e in ipairs(w.nativeEvents) do if e.kind=="down" and e.at>1.6 then assert(e.color==red) end end
		zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."mixed Keep colors report waiting targets without aiming or rewriting palette",function()
		local w,api=start(deferred);api.SetKeepColor(true);local p=add(w,api,1)[1];verify(w,api,p)
		w.player:SetAttribute("PaintBucketColor",w.Color3.new(1,0,0));w.flush()
		local events=#w.nativeEvents;api.SetPainting(true);w.step(5)
		assert(api.GetStats().WaitingForPalette==1 and api.GetStats().Dirty==1 and #w.nativeEvents==events)
		api.RemoveProvince(p);assert(api.GetStats().WaitingForPalette==0)
		zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."full title drag clamps the menu and produces no selection or automated input",function()
		local w,api=start(deferred);local p=w.province();w.mouse.Target=p
		local before=w.connections;local s=api.GetStats();local x,y=s.WindowX+20,s.WindowY+12
		clickEvent(w,"InputBegan",x,y)
		named(w,"DragTitle").InputBegan:Fire({UserInputType=w.env.Enum.UserInputType.MouseButton1});w.flush()
		assert(api.GetStats().Dragging)
		w.cursor=w.v(5000,5000);w.input.InputChanged:Fire({UserInputType=w.env.Enum.UserInputType.MouseMovement});w.flush()
		s=api.GetStats();assert(s.WindowX==380 and s.WindowY==36 and s.Selected==0)
		clickEvent(w,"InputEnded",5000,5000);w.step(.3)
		assert(not api.GetStats().Dragging and #w.nativeEvents==0 and w.connections==before)
		assert(w.load(SOURCE).GetStats().WindowX==380);zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."collapsed HUD reports state expands and STOP releases owned input",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		api.SetPainting(true);waitHold(w,api);w.step(.1)
		assert(api.GetStats().Collapsed and named(w,"CombatHUD").Visible and not named(w,"Panel").Visible)
		w.step(.25);local text=named(w,"CombatStatus").Text
		assert(text:find("AUTO: ON",1,true) and text:find("Protected: 1",1,true) and text:find("Dirty: 1",1,true) and text:find("Current Target: Province",1,true))
		button(w,"STOP");assert(not w.button and not api.GetStats().Painting)
		button(w,"+");assert(not api.GetStats().Collapsed and named(w,"Panel").Visible)
		button(w,"—");assert(api.GetStats().Collapsed);zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."dragging collapsed HUD suspends automated input until physical drag ends",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		api.SetPainting(true);waitHold(w,api);local s=api.GetStats()
		clickEvent(w,"InputBegan",s.WindowX+20,s.WindowY+10)
		named(w,"HUDDragTitle").InputBegan:Fire({UserInputType=w.env.Enum.UserInputType.MouseButton1});w.flush()
		local events=#w.nativeEvents;w.step(3);assert(#w.nativeEvents==events and not w.button and api.GetStats().Dragging)
		w.cursor=w.v(20,70);w.input.InputChanged:Fire({UserInputType=w.env.Enum.UserInputType.MouseMovement});w.flush()
		assert(api.GetStats().Selected==1 and #w.nativeEvents==events)
		clickEvent(w,"InputEnded",20,70);waitHold(w,api);zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."Done GUI click cannot register the province behind it",function()
		local w,api=start(deferred);local p=w.province();w.mouse.Target=p;button(w,"Protect Province")
		clickEvent(w,"InputBegan",400,56);assert(api.GetStats().Selected==0)
		clickEvent(w,"InputEnded",400,56);button(w,"Add · Done / Cancel");w.step(1)
		assert(api.GetStats().Selected==0 and #w.nativeEvents==0);zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."test button works after normal GUI mouse-up and observes release before movement",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];api.SetTestTarget(p)
		local s=api.GetStats();clickEvent(w,"InputBegan",s.WindowX+50,s.WindowY+120)
		clickEvent(w,"InputEnded",s.WindowX+50,s.WindowY+120)
		button(w,"TEST NATIVE INPUT");assert(#w.nativeEvents==0)
		w.step(1.6);assert(api.GetStats().Tested);zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."resize reclamps both full and collapsed windows without listener growth",function()
		local w,api=start(deferred);local before=w.connections
		api.SetCollapsed(true);w.workspace.CurrentCamera.ViewportSize=w.v(300,240);w.step(.3)
		local s=api.GetStats();assert(s.WindowX==0 and s.WindowY<=164)
		for _=1,100 do api.SetCollapsed(false);api.SetCollapsed(true) end
		assert(w.connections==before and #w.nativeEvents==0);api.Destroy();w.flush();assert(w.connections==0);zeroRPC(w,api)
	end)
	test(prefix.."missing down acknowledgment after a passed test stops even with a short FAST dwell",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		w.suppressDown=true;api.SetPainting(true);w.step(2)
		assert(not api.GetStats().Painting and not api.GetStats().Tested and not w.button and w.eventCount("down")==2)
		zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."explicit test also refuses a correct-color province",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];p.Color=api.GetDesiredColor();w.flush()
		api.SetTestTarget(p);assert(not api.TestNativeInput() and #w.nativeEvents==0);zeroRPC(w,api);api.Destroy()
	end)
	test(prefix.."continuous camera motion cannot starve a bounded multi-frame decision",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		for i=1,80 do api.AddProvince(w.province((i%10)*30,math.floor(i/10)*10)) end
		api.CommitSelections();api.SetPainting(true)
		local camera=w.workspace.CurrentCamera
		for i=1,60 do
			camera.CFrame=w.cf(w.v(i/100,100,0));w.step(1/60)
			if api.GetStats().Held then break end
		end
		assert(api.GetStats().Held);zeroRPC(w,api);api.Destroy();w.flush()
	end)
	test(prefix.."a clean target is defensively rejected even before its deferred notification",function()
		local w,api=start(deferred);local p=add(w,api,1)[1];verify(w,api,p)
		api.SetPainting(true);p._props.Color=api.GetDesiredColor()
		local events=#w.nativeEvents;w.step(3)
		assert(#w.nativeEvents==events and api.GetStats().Dirty==0);zeroRPC(w,api);api.Destroy()
	end)

end
